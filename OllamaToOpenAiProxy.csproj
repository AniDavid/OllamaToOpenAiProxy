<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;publish\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="dashboard.html" LogicalName="OllamaToOpenAiProxy.dashboard.html" />
    <InternalsVisibleTo Include="OllamaToOpenAiProxy.Tests" />
  </ItemGroup>

</Project>
