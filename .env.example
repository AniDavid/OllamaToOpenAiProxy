# OllamaToOpenAiProxy Environment Variables
# These can be set as environment variables or in appsettings.json

# Target OpenAI-compatible API configuration (e.g. LM Studio, FreeToken, vLLM, llama.cpp, LocalAI)
OPENAI_URL=http://localhost:1234
# LMSTUDIO_URL is also supported for backwards compatibility
# LMSTUDIO_URL=http://localhost:1234

PROXY_HOST=0.0.0.0
PROXY_PORT=11434
TIMEOUT_SECONDS=600
ENABLE_LOGGING=true

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production